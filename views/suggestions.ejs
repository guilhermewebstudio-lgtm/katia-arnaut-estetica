<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body data-page="suggestions">
  <%- include('partials/nav') %>

  <div class="page-header">
    <div class="container">
      <span class="eyebrow"><%= t.hero_eyebrow %></span>
      <h2><%= t.suggestions_title %></h2>
      <p class="section-subtitle"><%= t.suggestions_subtitle %></p>
    </div>
  </div>

  <div class="booking-form-wrap">
    <% if (success) { %>
      <div class="form-success"><%= t.suggestions_success %></div>
    <% } %>

    <form method="POST" action="/sugestoes">
      <div class="field">
        <label for="message"><%= t.suggestions_title %></label>
        <textarea id="message" name="message" placeholder="<%= t.suggestions_placeholder %>" required style="min-height:140px;"></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-block"><%= t.suggestions_submit %></button>
    </form>
  </div>

  <div class="container bookings-list">
    <h3 style="margin-bottom:1.2rem;"><%= t.suggestions_history %></h3>

    <% if (suggestions.length === 0) { %>
      <div class="empty-state">
        <p><%= t.suggestions_empty %></p>
      </div>
    <% } else { %>
      <% suggestions.forEach(function(s) { %>
        <div class="admin-card" data-reveal>
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;">
            <p style="color:var(--color-ink-soft);font-family:var(--font-mono);font-size:0.75rem;">
              <%= new Date(s.created_at).toLocaleDateString(lang === 'en' ? 'en-GB' : 'pt-PT', { day: '2-digit', month: 'short', year: 'numeric' }) %>
            </p>
            <span class="status-badge <%= s.admin_response ? 'status-confirmed' : 'status-pending' %>">
              <%= s.admin_response ? t.suggestions_status_answered : t.suggestions_status_pending %>
            </span>
          </div>
          <p style="margin-top:0.6rem;"><%= s.message %></p>
          <% if (s.admin_response) { %>
            <div style="margin-top:1rem;padding:1rem;background:var(--color-bg-alt);border-radius:4px;border-left:2px solid var(--color-clay);">
              <strong style="font-family:var(--font-mono);font-size:0.72rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-sage-deep);"><%= t.suggestions_response_label %></strong>
              <p style="margin-top:0.5rem;"><%= s.admin_response %></p>
            </div>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </div>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
