<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body data-page="home">
  <!-- PRELOADER -->
  <div class="preloader" id="preloader">
    <div class="preloader-mark">
      <svg viewBox="0 0 140 140">
        <circle class="preloader-ring" cx="70" cy="70" r="64"></circle>
        <circle class="preloader-ring-progress" cx="70" cy="70" r="64"></circle>
        <text x="70" y="82" text-anchor="middle" class="preloader-letter">K</text>
      </svg>
    </div>
    <div class="preloader-label"><%= lang === 'en' ? 'Facial Aesthetics · Lisbon' : 'Estética Facial · Lisboa' %></div>
  </div>

  <%- include('partials/nav') %>

  <!-- HERO — cinematic full-bleed -->
  <section class="hero-cinematic">
    <div class="hero-bg-image">
      <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=1920&q=80" alt="Katia Arnaut Estética">
    </div>
    <div class="hero-scrim"></div>

    <div class="hero-badge" data-hero-in style="opacity:0;transform:translateY(20px);">
      <div class="hero-badge-label"><%= lang === 'en' ? 'Since' : 'Desde' %></div>
      <div class="hero-badge-value">2016</div>
    </div>

    <div class="container">
      <span class="eyebrow" data-hero-in style="opacity:0;transform:translateY(20px);"><%= t.hero_eyebrow %></span>
      <h1 class="hero-title-cinematic" data-hero-in style="opacity:0;transform:translateY(20px);"><%= t.hero_title_line1 %> <em><%= t.hero_title_line2 %></em></h1>
      <p class="hero-subtitle" data-hero-in style="opacity:0;transform:translateY(20px);margin-top:1.3rem;"><%= t.hero_subtitle %></p>
      <div class="hero-actions" data-hero-in style="opacity:0;transform:translateY(20px);">
        <a href="/marcar" class="btn btn-primary"><%= t.hero_cta_primary %></a>
        <a href="#tratamentos" class="btn btn-outline" style="border-color:rgba(248,245,238,0.4);color:var(--color-bg);"><%= t.hero_cta_secondary %></a>
      </div>
      <div class="hero-note" data-hero-in style="opacity:0;transform:translateY(20px);"><%= t.hero_note %></div>
    </div>

    <div class="hero-scroll-cue" aria-hidden="true">
      <span><%= lang === 'en' ? 'Scroll' : 'Descer' %></span>
      <div class="hero-scroll-line"></div>
    </div>
  </section>

  <div class="marquee-strip" aria-hidden="true">
    <div class="marquee-track">
      <span><%= lang === 'en' ? 'Facial Cleansing' : 'Limpeza de Pele' %></span>
      <span><%= lang === 'en' ? 'Acne Treatment' : 'Tratamento de Acne' %></span>
      <span><%= lang === 'en' ? 'Chemical Peel' : 'Peeling Químico' %></span>
      <span><%= lang === 'en' ? 'Microneedling' : 'Microagulhamento' %></span>
      <span><%= lang === 'en' ? 'Radiofrequency' : 'Radiofrequência' %></span>
      <span>Benfica, Lisboa</span>
    </div>
  </div>

  <!-- SERVICES -->
  <section class="section" id="tratamentos">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow"><%= t.services_eyebrow %></span>
        <h2><%= t.services_title %></h2>
        <p class="section-subtitle"><%= t.services_subtitle %></p>
      </div>

      <div class="services-grid" data-reveal-group>
        <% services.forEach(function(s, i) { %>
          <div class="service-card" data-reveal-item>
            <span class="service-index"><%= String(i + 1).padStart(2, '0') %></span>
            <h3><%= lang === 'en' ? s.name_en : s.name_pt %></h3>
            <p><%= lang === 'en' ? s.description_en : s.description_pt %></p>
            <div class="service-meta">
              <span class="service-price"><% if (s.price) { %><small><%= t.service_from %></small> €<%= parseFloat(s.price).toFixed(0) %><% } %></span>
              <span class="service-duration"><%= s.duration_minutes %> <%= t.service_duration %></span>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section about-section" id="sobre">
    <div class="container about-grid">
      <div class="about-visual" data-reveal data-parallax>
        <img src="https://images.unsplash.com/photo-1643684391140-c5056cfd3436?auto=format&fit=crop&w=700&q=80" alt="Katia Arnaut Estética" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
      </div>
      <div data-reveal>
        <span class="eyebrow"><%= t.about_eyebrow %></span>
        <h2><%= t.about_title %></h2>
        <p style="margin-top:1rem;"><%= t.about_p1 %></p>
        <p style="margin-top:0.8rem;"><%= t.about_p2 %></p>

        <div class="about-stats">
          <div>
            <div class="about-stat-num"><%= t.about_stat1_num %></div>
            <div class="about-stat-label"><%= t.about_stat1_label %></div>
          </div>
          <div>
            <div class="about-stat-num"><%= t.about_stat2_num %></div>
            <div class="about-stat-label"><%= t.about_stat2_label %></div>
          </div>
          <div>
            <div class="about-stat-num"><%= t.about_stat3_num %></div>
            <div class="about-stat-label"><%= t.about_stat3_label %></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SIGNATURE QUOTE — personal touch -->
  <section class="signature-section" data-reveal>
    <div class="container signature-inner">
      <svg class="signature-mark" width="56" height="56" viewBox="0 0 56 56" fill="none" aria-hidden="true">
        <circle cx="28" cy="28" r="26" stroke="currentColor" stroke-width="1"/>
        <text x="28" y="37" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="24" fill="currentColor">KA</text>
      </svg>
      <p class="signature-quote">"<%= t.signature_quote %>"</p>
      <div class="signature-attribution">
        <span class="signature-name">Katia Arnaut</span>
        <span class="signature-role"><%= t.signature_role %></span>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section" id="equipa">
    <div class="container">
      <div class="section-head center" data-reveal style="margin-left:auto;margin-right:auto;">
        <span class="eyebrow"><%= t.team_eyebrow %></span>
        <h2><%= t.team_title %></h2>
        <p class="section-subtitle"><%= t.team_subtitle %></p>
      </div>

      <div class="team-grid" data-reveal-group>
        <% const teamPhotos = [
          'https://images.unsplash.com/photo-1785852790570-0d2858068c70?auto=format&fit=crop&w=500&q=80',
          'https://images.unsplash.com/photo-1559185590-879c66a55254?auto=format&fit=crop&w=500&q=80',
          'https://images.unsplash.com/photo-1782159981439-b99dfb84f4b8?auto=format&fit=crop&w=500&q=80'
        ]; %>
        <% team.forEach(function(member, mi) { %>
          <div class="team-card" data-reveal-item>
            <div class="team-photo">
              <% if (member.photo_url) { %>
                <img src="<%= member.photo_url %>" alt="<%= member.name %>">
              <% } else { %>
                <img src="<%= teamPhotos[mi % teamPhotos.length] %>" alt="<%= member.name %>" loading="lazy">
              <% } %>
              <span class="team-photo-caption"><%= lang === 'en' ? member.role_en : member.role_pt %></span>
            </div>
            <h3><%= member.name %></h3>
            <div class="team-role"><%= lang === 'en' ? member.role_en : member.role_pt %></div>
            <p class="team-bio"><%= lang === 'en' ? member.bio_en : member.bio_pt %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section" id="galeria" style="background:var(--color-bg-alt);">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow"><%= t.gallery_eyebrow %></span>
        <h2><%= t.gallery_title %></h2>
        <p class="section-subtitle"><%= t.gallery_subtitle %></p>
      </div>
      <div class="gallery-grid" data-reveal-group>
        <% const galleryPhotos = [
          { src: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=900&q=80', caption_pt: 'Tratamento facial', caption_en: 'Facial treatment' },
          { src: 'https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?auto=format&fit=crop&w=900&q=80', caption_pt: 'Limpeza de pele', caption_en: 'Skin cleansing' },
          { src: 'https://images.unsplash.com/photo-1731514771613-991a02407132?auto=format&fit=crop&w=900&q=80', caption_pt: 'Máscara facial', caption_en: 'Facial mask' },
          { src: 'https://images.unsplash.com/photo-1761718210089-ba3bb5ccb54f?auto=format&fit=crop&w=900&q=80', caption_pt: 'Cuidado personalizado', caption_en: 'Personalized care' },
          { src: 'https://images.unsplash.com/photo-1761718209835-c8586b7dcac0?auto=format&fit=crop&w=900&q=80', caption_pt: 'Aplicação de tratamento', caption_en: 'Treatment application' },
          { src: 'https://images.unsplash.com/photo-1559185590-d545a0c5a1dc?auto=format&fit=crop&w=900&q=80', caption_pt: 'O nosso espaço', caption_en: 'Our space' },
          { src: 'https://images.unsplash.com/photo-1761718209793-cb6d348831e0?auto=format&fit=crop&w=900&q=80', caption_pt: 'Técnica apurada', caption_en: 'Refined technique' },
          { src: 'https://images.unsplash.com/photo-1559185590-fcf099ac62c5?auto=format&fit=crop&w=900&q=80', caption_pt: 'Ambiente acolhedor', caption_en: 'Welcoming ambience' },
          { src: 'https://images.unsplash.com/photo-1643684391140-c5056cfd3436?auto=format&fit=crop&w=900&q=80', caption_pt: 'Momento de relaxamento', caption_en: 'A moment of relaxation' },
          { src: 'https://images.unsplash.com/photo-1782159981439-b99dfb84f4b8?auto=format&fit=crop&w=900&q=80', caption_pt: 'Produtos selecionados', caption_en: 'Selected products' }
        ]; %>
        <% galleryPhotos.forEach(function(photo, i) { %>
          <div class="gallery-item <%= i === 0 || i === 5 ? 'tall' : '' %>" data-reveal-item data-lightbox data-src="<%= photo.src.replace('w=900', 'w=1600') %>" data-caption="<%= lang === 'en' ? photo.caption_en : photo.caption_pt %>">
            <img src="<%= photo.src %>" alt="<%= lang === 'en' ? photo.caption_en : photo.caption_pt %>" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
            <span class="gallery-item-caption"><%= lang === 'en' ? photo.caption_en : photo.caption_pt %></span>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightboxClose" aria-label="Fechar">✕</button>
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Anterior">‹</button>
    <img src="" alt="" id="lightboxImg">
    <button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Seguinte">›</button>
    <span class="lightbox-caption" id="lightboxCaption"></span>
  </div>

  <!-- TESTIMONIALS -->
  <section class="section testimonials-section">
    <div class="container">
      <div class="section-head center" data-reveal style="margin-left:auto;margin-right:auto;">
        <span class="eyebrow"><%= t.testimonials_eyebrow %></span>
        <h2><%= t.testimonials_title %></h2>
      </div>
      <div class="testimonials-grid" data-reveal-group>
        <% const testimonials = lang === 'en' ? [
          { name: 'Sofia M.', text: 'The best skincare experience I\'ve had in Lisbon. Personal, attentive, and the results speak for themselves.', treatment: 'Deep Cleansing' },
          { name: 'Rita C.', text: 'Katia genuinely listens before recommending anything. My skin has never looked this even.', treatment: 'Chemical Peel' },
          { name: 'Marta A.', text: 'A calm, welcoming space with real technical knowledge behind it. Highly recommend.', treatment: 'Acne Treatment' }
        ] : [
          { name: 'Sofia M.', text: 'A melhor experiência de estética que já tive em Lisboa. Pessoal, atenta, e os resultados falam por si.', treatment: 'Limpeza Profunda' },
          { name: 'Rita C.', text: 'A Katia ouve mesmo antes de recomendar seja o que for. A minha pele nunca esteve tão uniforme.', treatment: 'Peeling Químico' },
          { name: 'Marta A.', text: 'Um espaço calmo e acolhedor, com conhecimento técnico a sério por trás. Recomendo vivamente.', treatment: 'Tratamento de Acne' }
        ]; %>
        <% testimonials.forEach(function(tst) { %>
          <div class="testimonial-card" data-reveal-item>
            <svg class="testimonial-quote-mark" width="28" height="22" viewBox="0 0 28 22" fill="none" aria-hidden="true">
              <path d="M0 22V13.5Q0 6 4 3T12 0V4Q8 5 6.5 7.5T5 13H10V22H0ZM16 22V13.5Q16 6 20 3T28 0V4Q24 5 22.5 7.5T21 13H26V22H16Z" fill="currentColor"/>
            </svg>
            <p class="testimonial-text"><%= tst.text %></p>
            <div class="testimonial-meta">
              <span class="testimonial-name"><%= tst.name %></span>
              <span class="testimonial-treatment"><%= tst.treatment %></span>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section contact-section" id="contactos">
    <div class="container">
      <div data-reveal>
        <span class="eyebrow"><%= t.contact_eyebrow %></span>
        <h2><%= t.contact_title %></h2>
        <p class="section-subtitle" style="margin-top:1rem;"><%= t.contact_subtitle %></p>
      </div>

      <div class="contact-grid" data-reveal-group>
        <div class="contact-card" data-reveal-item>
          <div class="contact-card-label"><%= t.contact_instagram %></div>
          <a href="https://www.instagram.com/katiaarnaut_esteticalisboa/" target="_blank" rel="noopener" class="contact-card-value">@katiaarnaut_esteticalisboa</a>
          <div style="margin-top:1.5rem;">
            <div class="contact-card-label"><%= t.contact_location %></div>
            <div class="contact-card-value" style="font-size:1.2rem;"><%= t.contact_location_value %></div>
          </div>
          <a href="https://www.instagram.com/katiaarnaut_esteticalisboa/" target="_blank" rel="noopener" class="btn btn-outline" style="margin-top:1.5rem;border-color:rgba(248,245,238,0.3);color:var(--color-bg);">
            <%= t.contact_instagram %>
          </a>
          <a href="/marcar" class="btn btn-clay" style="margin-top:0.8rem;">
            <%= t.hero_cta_primary %>
          </a>
        </div>

        <div class="contact-card" data-reveal-item>
          <div class="contact-card-label"><%= t.contact_hours %></div>
          <table class="hours-table">
            <% const dayKeys = ['day_0','day_1','day_2','day_3','day_4','day_5','day_6'];
               const today = new Date().getDay();
               hours.forEach(function(h) { %>
              <tr class="<%= h.day_of_week === today ? 'today' : '' %> <%= h.is_closed ? 'closed' : '' %>">
                <td><%= t[dayKeys[h.day_of_week]] %></td>
                <td><%= h.is_closed ? t.admin_closed : (h.open_time.slice(0,5) + ' – ' + h.close_time.slice(0,5)) %></td>
              </tr>
            <% }); %>
          </table>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <script src="/js/main.js"></script>
</body>
</html>
