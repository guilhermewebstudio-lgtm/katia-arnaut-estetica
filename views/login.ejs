<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>

  <div class="auth-wrap">
    <div class="auth-card">
      <span class="eyebrow">Katia Arnaut Estética</span>
      <h2><%= t.login_title %></h2>
      <p class="auth-sub"><%= lang === 'en' ? 'Log in to book your appointment.' : 'Entre para marcar a sua consulta.' %></p>

      <% if (error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="field">
          <label for="email"><%= t.login_email %></label>
          <input type="email" id="email" name="email" required autocomplete="email">
        </div>
        <div class="field">
          <label for="password"><%= t.login_password %></label>
          <input type="password" id="password" name="password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary btn-block"><%= t.login_submit %></button>
      </form>

      <div class="auth-switch">
        <%= t.login_no_account %> <a href="/register"><%= t.login_register_link %></a>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
