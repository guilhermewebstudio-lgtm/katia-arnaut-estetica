<footer class="footer-new">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-brand-col">
        <div class="brand footer-brand">Katia Arnaut <small>Estética</small></div>
        <p class="footer-tagline"><%= t.footer_tagline %></p>
        <a href="https://www.instagram.com/katiaarnaut_esteticalisboa/" target="_blank" rel="noopener" class="footer-insta-link">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
            <rect x="2" y="2" width="20" height="20" rx="5.5" stroke="currentColor" stroke-width="1.8"/>
            <circle cx="12" cy="12" r="4.3" stroke="currentColor" stroke-width="1.8"/>
            <circle cx="17.4" cy="6.6" r="1.15" fill="currentColor"/>
          </svg>
          @katiaarnaut_esteticalisboa
        </a>
      </div>

      <div class="footer-col">
        <span class="footer-col-title"><%= t.footer_explore %></span>
        <a href="/#tratamentos"><%= t.nav_services %></a>
        <a href="/#sobre"><%= t.nav_about %></a>
        <a href="/#equipa"><%= t.nav_team %></a>
        <a href="/#galeria"><%= t.nav_gallery %></a>
        <a href="/#contactos"><%= t.nav_contact %></a>
      </div>

      <div class="footer-col">
        <span class="footer-col-title"><%= t.footer_account %></span>
        <% if (session.userId) { %>
          <a href="/marcar"><%= t.nav_book %></a>
          <a href="/as-minhas-marcacoes"><%= t.nav_my_bookings %></a>
          <a href="/sugestoes"><%= t.nav_suggestions %></a>
        <% } else { %>
          <a href="/login"><%= t.nav_login %></a>
          <a href="/register"><%= t.nav_register %></a>
          <a href="/marcar"><%= t.nav_book %></a>
        <% } %>
      </div>

      <div class="footer-col">
        <span class="footer-col-title"><%= t.contact_hours %></span>
        <div class="footer-hours-line"><span><%= lang === 'en' ? 'Mon – Fri' : 'Seg – Sex' %></span><span>9h30 – 19h00</span></div>
        <div class="footer-hours-line"><span><%= lang === 'en' ? 'Saturday' : 'Sábado' %></span><span>10h00 – 15h00</span></div>
        <div class="footer-hours-line"><span><%= lang === 'en' ? 'Sunday' : 'Domingo' %></span><span><%= t.admin_closed %></span></div>
        <span class="footer-col-title" style="margin-top:1.2rem;"><%= t.contact_location %></span>
        <span class="footer-location-text"><%= t.contact_location_value %></span>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-note">Katia Arnaut Estética © <%= new Date().getFullYear() %> · <%= t.footer_rights %></span>
      <span class="footer-note"><%= t.footer_made_by %> <a href="https://www.instagram.com/katiaarnaut_esteticalisboa/" target="_blank" rel="noopener" style="color:var(--color-clay);opacity:1;">Guilherme</a></span>
    </div>
  </div>
</footer>
